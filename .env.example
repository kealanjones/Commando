# Everything in this file is safe to put into a hosting provider.
#
# Vercel and Netlify read this file when importing the repo and offer these
# as environment variables. That is exactly why nothing dangerous lives here.

# Your Supabase project URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key (sb_publishable_…). Older projects call it the ANON key
# and it looks like a JWT (eyJ…). Either works.
#
# This is compiled into the JavaScript bundle and is readable by anyone who
# views source. That is safe ONLY because row level security is enabled and
# forced on every table — see supabase/migrations/0002_rls.sql, and
# tests/rls.sh, which proves an unauthenticated caller holding this key gets
# nothing back.
VITE_SUPABASE_ANON_KEY=sb_publishable_...
