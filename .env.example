# ── Browser-visible ────────────────────────────────────────────────
# Supabase calls this the PUBLISHABLE key (sb_publishable_…).
# On older projects it is called the ANON key and looks like a JWT (eyJ…).
# Either works. It is compiled into the JavaScript bundle and is safe there
# ONLY because RLS is enabled and forced on every table — see
# supabase/migrations/0002_rls.sql, and tests/rls.sh which proves it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── Seed script only. Never leaves your machine. ───────────────────
# Supabase calls this the SECRET key (sb_secret_…).
# On older projects it is called the SERVICE ROLE key.
# It BYPASSES ROW LEVEL SECURITY ENTIRELY. Never prefix it with VITE_,
# never put it in hosting environment variables, never commit it.
# If it leaks, rotate it in the dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# The account seeded rows belong to. Must already exist in Supabase Auth —
# invite it from Authentication → Users before seeding.
SEED_OWNER_EMAIL=you@example.com
