# Browser-visible. The anon key is safe to ship ONLY because RLS is enabled
# on every table — see supabase/migrations/0002_rls.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Seed script only. NEVER prefix with VITE_ and never commit.
# Bypasses RLS, so it lives on your machine and in CI secrets, nowhere else.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The account the seeded rows belong to. Must already exist in Supabase Auth.
SEED_OWNER_EMAIL=you@example.com
