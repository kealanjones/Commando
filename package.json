{
  "name": "work-register",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:dry": "tsx scripts/seed.ts --dry-run",
    "build:demo": "vite build --mode demo --outDir dist",
    "serve:dist": "node tests/serve.mjs",
    "test:ui": "node tests/interactions.mjs",
    "test:shots": "node tests/screenshots.mjs",
    "build:preview": "ARTIFACT=1 vite build --mode artifact --outDir dist-artifact && node scripts/inline.mjs dist-artifact preview.html",
    "test:intake": "node tests/intake.mjs",
    "seed:sql": "tsx scripts/seed-sql.ts",
    "test:review": "node tests/review.mjs",
    "test:paste": "node tests/paste.mjs",
    "test:parse": "tsx tests/parse.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "dotenv": "^16.4.5",
    "playwright": "^1.47.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "wait-on": "^8.0.1"
  }
}
